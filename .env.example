# Copy this file to .env and fill in values, or just `export` these in your
# shell before running the API.

# "ollama" (free, local, matches your Chapter 3 tech choice) or "anthropic"
WORKLOADLENS_LLM_BACKEND=ollama

# Only used when WORKLOADLENS_LLM_BACKEND=ollama
WORKLOADLENS_OLLAMA_MODEL=llama3

# Only used when WORKLOADLENS_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...
WORKLOADLENS_ANTHROPIC_MODEL=claude-sonnet-4-6
